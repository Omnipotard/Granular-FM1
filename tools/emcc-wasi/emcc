#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""An `emcc` stand-in for fm1-base's `build.py --web`: clang (15+, with the wasm32 target and wasm-ld) and the WASI
sysroot of wasi-sdk 25, no Emscripten. tools/emcc-wasi/get_wasi.sh fetches the sysroot into $WASI_DIR (~/.wasi).
    PATH="$PWD/tools/emcc-wasi:$PATH" ./build.sh --web
It maps the emcc options build.py uses (-sSTANDALONE_WASM, -sSTACK_SIZE, -sINITIAL_MEMORY, -sALLOW_MEMORY_GROWTH=0,
-sFILESYSTEM, --no-entry) onto clang and wasm-ld; the module is a WASI reactor (it exports _initialize, which
fm1-base's worklet calls). With --rfm1 (and an em-config on the PATH) it builds the .rfm1 too: a fixed memory, as
Emscripten makes it when the memory may not grow (the maximum the initial size: tools/rfm1_pack.py checks it)."""
import os
import subprocess
import sys

WASI = os.path.expanduser(os.environ.get("WASI_DIR", "~/.wasi"))
SYSROOT = os.path.join(WASI, "wasi-sysroot-25.0")
RT = os.path.join(WASI, "libclang_rt.builtins-wasm32-wasi-25.0", "libclang_rt.builtins-wasm32.a")
RES = os.path.join(WASI, "resdir")


def resdir():
    """a clang resource dir: clang's own headers, and the wasm32 builtins where the driver looks for them"""
    lib = os.path.join(RES, "lib", "wasip1")
    if not os.path.exists(os.path.join(lib, "libclang_rt.builtins-wasm32.a")):
        os.makedirs(lib, exist_ok=True)
        inc = os.path.join(subprocess.run(["clang", "-print-resource-dir"], capture_output=True, text=True,
                                          check=True).stdout.strip(), "include")
        if not os.path.exists(os.path.join(RES, "include")):
            os.symlink(inc, os.path.join(RES, "include"))
        with open(RT, "rb") as a, open(os.path.join(lib, "libclang_rt.builtins-wasm32.a"), "wb") as b:
            b.write(a.read())
    return RES


args = sys.argv[1:]
if "--version" in args:
    print("emcc (clang + WASI shim) 4.0.0")
    sys.exit(0)
if not os.path.isdir(SYSROOT):
    sys.exit(f"emcc-wasi: no WASI sysroot in {WASI} (tools/emcc-wasi/get_wasi.sh)")
out, stack, mem, fixed = [], 1048576, 33554432, False
for a in args:
    if a.startswith("-sSTACK_SIZE="):
        stack = int(a.split("=")[1])
    elif a.startswith("-sINITIAL_MEMORY="):
        mem = int(a.split("=")[1])
    elif a == "-sALLOW_MEMORY_GROWTH=0":
        fixed = True
    elif a.startswith("-s") or a == "--no-entry":
        continue
    else:
        out.append(a)
cmd = ["clang", "--target=wasm32-wasip1", f"--sysroot={SYSROOT}", f"-resource-dir={resdir()}", "-fno-exceptions"]
if "-c" in out:
    cmd += out
else:
    cmd += ["-mexec-model=reactor", *out, "-Wl,--export-dynamic", "-Wl,--no-entry", f"-Wl,-z,stack-size={stack}",
            f"-Wl,--initial-memory={mem}", *([f"-Wl,--max-memory={mem}"] if fixed else []), "-Wl,--allow-undefined"]
sys.exit(subprocess.run(cmd).returncode)
